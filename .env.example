# ============================================
# DarImmo Backend — Variables d'environnement
# ============================================
# Ce fichier est un MODÈLE.
# Copie-le en .env et remplis les vraies valeurs.
# Le .env ne doit JAMAIS être versionné sur Git.

# Environnement : development | production
NODE_ENV=development

# Port du serveur Express
PORT=5000

# URI de connexion MongoDB Atlas
# Format : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/darimmo?retryWrites=true&w=majority

# JWT (sera utilisé à l'Étape 2)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Cloudinary (Étape 7)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=